{
    "agent": {
        "metrics_collection_interval": 60
    },
    "logs": {
        "logs_collected": {
            "windows_events": {
                "collect_list": [
                    {
                        "event_name": "Microsoft-Windows-Desired-State-Configuration/Operational",
                        "event_levels": ["ERROR", "WARNING", "INFORMATION"],
                        "log_group_name": "/aws/systemsmanager/dsc",
                        "log_stream_name": "{instance_id}"
                    },
                    {
                        "event_name": "Microsoft-Windows-PowerShell/Operational",
                        "event_levels": ["ERROR", "WARNING"],
                        "log_group_name": "/aws/systemsmanager/powershell",
                        "log_stream_name": "{instance_id}"
                    }
                ]
            },
            "files": {
                "collect_list": [
                    {
                        "file_path": "C:\\ProgramData\\Amazon\\SSM\\Logs\\amazon-ssm-agent.log",
                        "log_group_name": "/aws/systemsmanager/ssm-agent",
                        "log_stream_name": "{instance_id}"
                    },
                    {
                        "file_path": "C:\\Logs\\DSC\\dsc-execution.log",
                        "log_group_name": "/aws/systemsmanager/dsc-files",
                        "log_stream_name": "{instance_id}"
                    },
                    {
                        "file_path": "C:\\ProgramData\\Amazon\\SSM\\InstanceData\\*\\document\\orchestration\\*\\*\\stdout",
                        "log_group_name": "/aws/systemsmanager/ssm-stdout",
                        "log_stream_name": "{instance_id}"
                    },
                    {
                        "file_path": "C:\\ProgramData\\Amazon\\SSM\\InstanceData\\*\\document\\orchestration\\*\\*\\stderr",
                        "log_group_name": "/aws/systemsmanager/ssm-stderr",
                        "log_stream_name": "{instance_id}"
                    }
                ]
            }
        }
    }
}