      "coverage": {
        "systems": 100,
        "applications": 100,
        "databases": 100,
        "networkDevices": 100,
        "unit": "percentage"
      }
    },
    "remediationRequirements": {
      "timeframes": {
        "critical": 72,
        "high": 168,
        "medium": 720,
        "low": 2160,
        "unit": "hours"
      },
      "prioritization": {
        "criteria": ["CVSS Score", "Asset Criticality", "Threat Intelligence", "Exploit Availability"],
