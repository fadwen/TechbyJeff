{
  "metadata": {
    "purpose": "Security baselines and compliance requirements for Find-UnknownSID operations",
    "framework": "Multi-Framework Compliance",
    "lastUpdated": "2024-01-15T10:30:00Z",
    "version": "1.0.0",
    "applicableFrameworks": [
      "NIST Cybersecurity Framework",
      "ISO 27001",
      "SOX",
      "GDPR",
      "HIPAA",
      "PCI DSS"
    ]
  },
  "authenticationBaselines": {
    "accountSecurity": {
      "minimumPasswordLength": 12,
      "passwordComplexity": true,
      "passwordExpiration": 90,
      "accountLockoutThreshold": 3,
      "lockoutDuration": 30,
      "lockoutResetTime": 15,
      "unit": "days for expiration, minutes for lockout"
    },
    "serviceAccounts": {
      "managedServiceAccounts": true,
      "passwordRotation": 30,
      "minimumPrivileges": true,
      "auditingEnabled": true,
      "unit": "days"
    },
    "multiFactor": {
      "required": true,
      "acceptedMethods": ["TOTP", "SMS", "Hardware Token", "Biometric"],
      "backupCodes": true,
      "sessionTimeout": 480,
      "unit": "minutes"
    }
  },
  "authorizationBaselines": {
    "roleBasedAccess": {
      "minimumRoles": [
        {
          "role": "ReadOnly",
          "permissions": ["ViewReports", "ViewLogs"],
          "description": "Read-only access to reports and logs"
        },
        {
          "role": "Operator",
          "permissions": ["ViewReports", "ViewLogs", "ExecuteScans"],
          "description": "Execute scans and view results"
        },
        {
          "role": "Administrator",
          "permissions": ["All"],
          "description": "Full administrative access"
        }
      ],
      "segregationOfDuties": true,
      "leastPrivilegeEnforcement": true
    },
    "privilegeEscalation": {
      "preventionMechanisms": ["UAC", "TokenFiltering", "IntegrityLevels"],
      "monitoringRequired": true,
      "alertingThreshold": "immediate",
      "auditingLevel": "detailed"
    },
    "accessReview": {
      "frequency": 90,
      "approvalRequired": true,
      "documentationMandatory": true,
      "revocationProcess": "automated",
      "unit": "days"
    }
  },
  "dataProtectionBaselines": {
    "encryptionRequirements": {
      "dataAtRest": {
        "required": true,
        "algorithm": "AES-256",
        "keyManagement": "centralized",
        "keyRotation": 365,
        "unit": "days"
      },
      "dataInTransit": {
        "required": true,
        "protocol": "TLS 1.3",
        "certificateValidation": "strict",
        "cipherSuites": ["ECDHE-RSA-AES256-GCM-SHA384", "ECDHE-RSA-AES128-GCM-SHA256"]
      },
      "keyProtection": {
        "hardwareSecurityModule": "recommended",
        "keyEscrow": false,
        "splitKnowledge": true,
        "dualControl": true
      }
    },
    "dataClassification": {
      "levels": [
        {
          "level": "Public",
          "markingRequired": false,
          "encryptionRequired": false,
          "accessControls": "standard"
        },
        {
          "level": "Internal",
          "markingRequired": true,
          "encryptionRequired": true,
          "accessControls": "restrictive"
        },
        {
          "level": "Confidential",
          "markingRequired": true,
          "encryptionRequired": true,
          "accessControls": "strict"
        },
        {
          "level": "Restricted",
          "markingRequired": true,
          "encryptionRequired": true,
          "accessControls": "maximum"
        }
      ],
      "handlingRequirements": {
        "labeling": "automatic",
        "retention": "policy-based",
        "disposal": "secure-wipe"
      }
    },
    "personalDataProtection": {
      "gdprCompliance": {
        "consentManagement": true,
        "rightToErasure": true,
        "dataPortability": true,
        "privacyByDesign": true,
        "dataProtectionOfficer": "required"
      },
      "dataMinimization": {
        "collectionLimited": true,
        "purposeLimited": true,
        "retentionLimited": true,
        "accuracyEnsured": true
      }
    }
  },
  "auditingBaselines": {
    "logRequirements": {
      "auditLogTypes": [
        "Authentication",
        "Authorization",
        "DataAccess",
        "ConfigurationChanges",
        "SystemEvents",
        "SecurityEvents",
        "PrivilegeUsage"
      ],
      "logFormat": "structured",
      "timestampPrecision": "millisecond",
      "integrity": "cryptographic",
      "retention": 2555,
      "unit": "days (7 years)"
    },
    "monitoringRequirements": {
      "realTimeAlerts": [
        "UnauthorizedAccess",
        "PrivilegeEscalation",
        "DataBreach",
        "SystemCompromise",
        "PolicyViolation"
      ],
      "alertingThresholds": {
        "failedLogins": 5,
        "privilegeChanges": 1,
        "dataAccess": "abnormal",
        "systemChanges": 1
      },
      "responseTime": {
        "critical": 5,
        "high": 15,
        "medium": 60,
        "low": 240,
        "unit": "minutes"
      }
    },
    "complianceReporting": {
      "frequency": {
        "internal": 30,
        "regulatory": 90,
        "executive": 365,
        "unit": "days"
      },
      "reportTypes": [
        "AccessReview",
        "SecurityIncidents",
        "ComplianceStatus",
        "RiskAssessment",
        "VulnerabilityStatus"
      ],
      "auditTrail": {
        "immutable": true,
        "digitallySigned": true,
        "chainOfCustody": true,
        "accessLogged": true
      }
    }
  },
